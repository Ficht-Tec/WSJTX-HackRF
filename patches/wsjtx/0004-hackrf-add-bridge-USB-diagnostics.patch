+
+  QString lastLineContaining (
+    QStringList const& rows,
+    QString const& marker)
+  {
+    for (auto it = rows.crbegin ();
+         it != rows.crend ();
+         ++it)
+      {
+        if (it->contains (marker))
+          {
+            return *it;
+          }
+      }
+
+    return {};
+  }
+
+
+  QMap<QString, QString> parseProperties (
+    QString const& line)
+  {
+    QMap<QString, QString> result;
+
+    auto const tokens =
+      line.split (' ', QString::SkipEmptyParts);
+
+    for (auto const& token : tokens)
+      {
+        auto const pos = token.indexOf ('=');
+
+        if (pos > 0)
+          {
+            result.insert (
+              token.left (pos),
+              token.mid (pos + 1));
+          }
+      }
+
+    return result;
+  }
 }
 
 
