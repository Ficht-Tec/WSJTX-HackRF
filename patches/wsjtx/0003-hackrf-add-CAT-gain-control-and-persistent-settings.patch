+QString HackRFGainDialog::catCommand (
+  QString const& command,
+  bool * ok)
+{
+  if (ok)
+    {
+      *ok = false;
+    }
+
+  QTcpSocket socket;
+
+  socket.connectToHost (
+    QStringLiteral ("127.0.0.1"),
+    hackrf_cat_port);
+
+  if (!socket.waitForConnected (
+        cat_connect_timeout_ms))
+    {
+      return socket.errorString ();
+    }
+
+  QByteArray request =
+    command.toLatin1 ();
+
+  request.append ('\n');
+
+  if (socket.write (request) < 0)
+    {
+      return socket.errorString ();
+    }
+
+  if (!socket.waitForBytesWritten (
+        cat_connect_timeout_ms))
+    {
+      return socket.errorString ();
+    }
+
+  QByteArray response;
+
+  QElapsedTimer elapsed;
+  elapsed.start ();
+
+  while (!response.contains ('\n')
+         && response.size () < 4096
+         && elapsed.elapsed ()
+              < cat_read_timeout_ms)
+    {
+      response.append (socket.readAll ());
+
+      if (response.contains ('\n'))
+        {
+          break;
+        }
+
+      int const remaining =
+        cat_read_timeout_ms
+        - static_cast<int> (elapsed.elapsed ());
+
+      if (remaining <= 0)
+        {
+          break;
+        }
+
+      if (!socket.waitForReadyRead (remaining))
+        {
+          break;
+        }
+    }
+
+  response.append (socket.readAll ());
+
+  QString const result =
+    QString::fromUtf8 (response)
+      .trimmed ()
+      .section ('\n', 0, 0)
+      .trimmed ();
+
+  if (result.isEmpty ())
+    {
+      return tr ("CAT: no response");
+    }
+
+  if (ok)
+    {
+      *ok = true;
+    }
+
+  return result;
+}
