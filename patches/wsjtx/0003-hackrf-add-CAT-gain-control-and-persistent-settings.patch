+  QMap<QString, QString> parseStatus (QString const& status)
+  {
+    QMap<QString, QString> result;
+
+    auto const tokens =
+      status.split (' ', QString::SkipEmptyParts);
+
+    for (auto const& token : tokens)
+      {
+        auto const pos = token.indexOf ('=');
+
+        if (pos > 0)
+          {
+            result.insert (token.left (pos),
+                           token.mid (pos + 1));
+          }
+      }
+
+    return result;
+  }
+}
