+
+void HackRFGainDialog::setLna ()
+{
+  if (!connected_ || updating_ui_)
+    {
+      return;
+    }
+
+  int const value =
+    lna_slider_->value () * 8;
+
+  bool ok {false};
+
+  QString const result =
+    catCommand (
+      QStringLiteral ("\\set_lna %1")
+        .arg (value),
+      &ok);
+
+  if (!ok
+      || result != QStringLiteral ("RPRT 0"))
+    {
+      bridge_status_label_->setText (
+        tr ("Error setting RX LNA: %1")
+          .arg (result));
+    }
+  else
+    {
+      saveGain (
+        QStringLiteral ("LNA"),
+        value);
+    }
+
+  QTimer::singleShot (
+    80,
+    this,
+    [this] {refreshStatus ();});
+}
+
+
+void HackRFGainDialog::setVga ()
+{
+  if (!connected_ || updating_ui_)
+    {
+      return;
+    }
+
+  int const value =
+    vga_slider_->value () * 2;
+
+  bool ok {false};
+
+  QString const result =
+    catCommand (
+      QStringLiteral ("\\set_vga %1")
+        .arg (value),
+      &ok);
+
+  if (!ok
+      || result != QStringLiteral ("RPRT 0"))
+    {
+      bridge_status_label_->setText (
+        tr ("Error setting RX VGA: %1")
+          .arg (result));
+    }
+  else
+    {
+      saveGain (
+        QStringLiteral ("VGA"),
+        value);
+    }
+
+  QTimer::singleShot (
+    80,
+    this,
+    [this] {refreshStatus ();});
+}
+
+
+void HackRFGainDialog::setAmp ()
+{
+  if (!connected_
+      || updating_ui_
+      || !amp_check_->isEnabled ())
+    {
+      return;
+    }
+
+  int const value =
+    amp_check_->isChecked () ? 1 : 0;
+
+  bool ok {false};
+
+  QString const result =
+    catCommand (
+      QStringLiteral ("\\set_amp %1")
+        .arg (value),
+      &ok);
+
+  if (!ok
+      || result != QStringLiteral ("RPRT 0"))
+    {
+      bridge_status_label_->setText (
+        tr ("Error setting RX AMP: %1")
+          .arg (result));
+    }
+  else
+    {
+      saveGain (
+        QStringLiteral ("AMP"),
+        value != 0);
+    }
+
+  QTimer::singleShot (
+    80,
+    this,
+    [this] {refreshStatus ();});
+}
+
+
+void HackRFGainDialog::setTxVga ()
+{
+  if (!connected_ || updating_ui_)
+    {
+      return;
+    }
+
+  int const value =
+    tx_vga_slider_->value ();
+
+  bool ok {false};
+
+  QString const result =
+    catCommand (
+      QStringLiteral ("\\set_tx_vga %1")
+        .arg (value),
+      &ok);
+
+  if (!ok
+      || result != QStringLiteral ("RPRT 0"))
+    {
+      bridge_status_label_->setText (
+        tr ("Error setting TX VGA: %1")
+          .arg (result));
+    }
+  else
+    {
+      saveGain (
+        QStringLiteral ("TXVGA"),
+        value);
+    }
+
+  QTimer::singleShot (
+    80,
+    this,
+    [this] {refreshStatus ();});
 }
