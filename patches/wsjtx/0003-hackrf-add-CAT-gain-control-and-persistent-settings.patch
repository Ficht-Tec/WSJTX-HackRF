+
+void HackRFGainDialog::setStatusError (
+  QString const& text)
+{
+  setConnected (false);
+
+  bridge_status_label_->setText (
+    tr ("CAT unavailable: %1").arg (text));
+
+  diagnostics_->setPlainText (
+    tr ("HackRF bridge CAT connection unavailable.\n"
+        "Address: 127.0.0.1:4532\n\n"
+        "%1")
+      .arg (text));
+}
