+void HackRFGainDialog::saveGain (
+  QString const& key,
+  QVariant const& value)
+{
+  if (!settings_)
+    {
+      return;
+    }
+
+  settings_->setValue (
+    QStringLiteral ("HackRF/") + key,
+    value);
+
+  settings_->sync ();
+}
