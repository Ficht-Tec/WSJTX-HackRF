+void HackRFGainDialog::restoreSavedGains (
+  int lna,
+  int vga,
+  bool amp,
+  int tx_vga)
+{
+  if (!settings_ || gains_restored_)
+    {
+      return;
+    }
+
+  bool const have_saved =
+    settings_->contains (
+      QStringLiteral ("HackRF/LNA"))
+    || settings_->contains (
+      QStringLiteral ("HackRF/VGA"))
+    || settings_->contains (
+      QStringLiteral ("HackRF/AMP"))
+    || settings_->contains (
+      QStringLiteral ("HackRF/TXVGA"));
+
+  //
+  // Primera ejecución:
+  // adoptar como configuración persistente el estado actual del bridge.
+  //
+  if (!have_saved)
+    {
+      saveGain (
+        QStringLiteral ("LNA"), lna);
+
+      saveGain (
+        QStringLiteral ("VGA"), vga);
+
+      saveGain (
+        QStringLiteral ("AMP"), amp);
+
+      saveGain (
+        QStringLiteral ("TXVGA"), tx_vga);
+
+      gains_restored_ = true;
+      return;
+    }
+
+  int const saved_lna =
+    settings_->value (
+      QStringLiteral ("HackRF/LNA"),
+      lna).toInt ();
+
+  int const saved_vga =
+    settings_->value (
+      QStringLiteral ("HackRF/VGA"),
+      vga).toInt ();
+
+  bool const saved_amp =
+    settings_->value (
+      QStringLiteral ("HackRF/AMP"),
+      amp).toBool ();
+
+  int const saved_tx_vga =
+    settings_->value (
+      QStringLiteral ("HackRF/TXVGA"),
+      tx_vga).toInt ();
+
+  bool ok {false};
+
+  if (saved_lna >= 0
+      && saved_lna <= 40
+      && (saved_lna % 8) == 0)
+    {
+      catCommand (
+        QStringLiteral ("\\set_lna %1")
+          .arg (saved_lna),
+        &ok);
+    }
+
+  if (saved_vga >= 0
+      && saved_vga <= 62
+      && (saved_vga % 2) == 0)
+    {
+      catCommand (
+        QStringLiteral ("\\set_vga %1")
+          .arg (saved_vga),
+        &ok);
+    }
+
+  catCommand (
+    QStringLiteral ("\\set_amp %1")
+      .arg (saved_amp ? 1 : 0),
+    &ok);
+
+  if (saved_tx_vga >= 0
+      && saved_tx_vga <= 47)
+    {
+      catCommand (
+        QStringLiteral ("\\set_tx_vga %1")
+          .arg (saved_tx_vga),
+        &ok);
+    }
+
+  gains_restored_ = true;
+
+  QTimer::singleShot (
+    100,
+    this,
+    [this] {refreshStatus ();});
+}
+
+
+void HackRFGainDialog::refreshStatus ()
+{
+  bool ok {false};
+
+  QString const raw =
+    catCommand (
+      QStringLiteral ("\\status"),
+      &ok);
+
+  if (!ok)
+    {
+      setStatusError (raw);
+      return;
+    }
+
+  auto const fields =
+    parseStatus (raw);
+
+  QString const rf_tx =
+    fields.value (
+      QStringLiteral ("rf_tx"));
+
+  if (rf_tx != QStringLiteral ("DISABLED")
+      && rf_tx != QStringLiteral ("ARMED")
+      && rf_tx != QStringLiteral ("ACTIVE"))
+    {
+      setStatusError (
+        tr ("Unknown RF state: %1")
+          .arg (rf_tx));
+
+      return;
+    }
+
+
+  updating_ui_ = true;
+  setConnected (true);
+
+
+  bool const in_tx =
+    fields.value (
+      QStringLiteral ("ptt_sim"))
+      == QStringLiteral ("1");
+
+
+  //
+  // LNA - use staged value as the requested setting.
+  //
+  bool lna_ok {false};
+
+  int const lna =
+    fields.value (
+      QStringLiteral ("lna_stage"),
+      fields.value (QStringLiteral ("lna")))
+      .toInt (&lna_ok);
+
+  if (lna_ok
+      && lna >= 0
+      && lna <= 40
+      && (lna % 8) == 0)
+    {
+      if (!lna_slider_->isSliderDown ())
+        {
+          QSignalBlocker blocker {lna_slider_};
+
+          lna_slider_->setValue (
+            lna / 8);
+        }
+
+      bool const pending =
+        in_tx
+        && fields.value (
+             QStringLiteral ("lna"))
+           != QString::number (lna);
+
+      lna_value_->setText (
+        QString::number (lna)
+        + tr (" dB")
+        + (pending
+           ? tr (" (pending)")
+           : QString {}));
+    }
+
+
+  //
+  // RX VGA - same staged behaviour.
+  //
+  bool vga_ok {false};
+
+  int const vga =
+    fields.value (
+      QStringLiteral ("vga_stage"),
+      fields.value (QStringLiteral ("vga")))
+      .toInt (&vga_ok);
+
+  if (vga_ok
+      && vga >= 0
+      && vga <= 62
+      && (vga % 2) == 0)
+    {
+      if (!vga_slider_->isSliderDown ())
+        {
+          QSignalBlocker blocker {vga_slider_};
+
+          vga_slider_->setValue (
+            vga / 2);
+        }
+
+      bool const pending =
+        in_tx
+        && fields.value (
+             QStringLiteral ("vga"))
+           != QString::number (vga);
+
+      vga_value_->setText (
+        QString::number (vga)
+        + tr (" dB")
+        + (pending
+           ? tr (" (pending)")
+           : QString {}));
+    }
+
+
+  //
+  // AMP cannot be changed while TX is active.
+  //
+  bool amp_ok {false};
+
+  int const amp =
+    fields.value (
+      QStringLiteral ("amp"))
+      .toInt (&amp_ok);
+
+  if (amp_ok
+      && (amp == 0 || amp == 1))
+    {
+      QSignalBlocker blocker {amp_check_};
+
+      amp_check_->setChecked (
+        amp != 0);
+    }
+
+  amp_check_->setEnabled (
+    connected_
+    && amp_ok
+    && !in_tx);
+
+
+  //
+  // TX VGA staged value.
+  //
+  bool tx_vga_ok {false};
+
+  int const tx_vga =
+    fields.value (
+      QStringLiteral ("tx_vga_stage"))
+      .toInt (&tx_vga_ok);
+
+  if (tx_vga_ok
+      && tx_vga >= 0
+      && tx_vga <= 47)
+    {
+      if (!tx_vga_slider_->isSliderDown ())
+        {
+          QSignalBlocker blocker {
+            tx_vga_slider_};
+
+          tx_vga_slider_->setValue (
+            tx_vga);
+        }
+
+      tx_vga_value_->setText (
+        QString::number (tx_vga)
+        + tr (" dB"));
+    }
+
+
+  //
+  // Restaurar la configuración persistente únicamente en RX.
+  // AMP no puede modificarse durante TX en HackRF.
+  //
+  if (!in_tx
+      && !gains_restored_
+      && lna_ok
+      && vga_ok
+      && amp_ok
+      && tx_vga_ok)
+    {
+      restoreSavedGains (
+        lna,
+        vga,
+        amp != 0,
+        tx_vga);
+
+      updating_ui_ = false;
+      return;
+    }
+
+
+  frequency_label_->setText (
+    tr ("CAT frequency: %1 Hz")
+      .arg (
+        fields.value (
+          QStringLiteral ("dial"),
+          QStringLiteral ("—"))));
+
+
+  bridge_status_label_->setText (
+    tr ("CAT connected · %1 · TX: %2 · "
+        "TX VGA applied: %3 dB")
+      .arg (
+        fields.value (
+          QStringLiteral ("state"),
+          QStringLiteral ("?")),
+        in_tx
+          ? tr ("ON")
+          : tr ("OFF"),
+        fields.value (
+          QStringLiteral ("tx_vga_applied"),
+          QStringLiteral ("—"))));
+
+
+  diagnostics_->setPlainText (
+    tr ("CAT bridge: connected\n"
+        "Address: 127.0.0.1:4532\n"
+        "RF TX state: %1\n\n"
+        "Raw bridge status:\n%2\n\n"
+        "USB block diagnostics will be added "
+        "from the HackRF bridge log in the "
+        "next integration step.")
+      .arg (rf_tx, raw));
+
+
+  updating_ui_ = false;
+}
