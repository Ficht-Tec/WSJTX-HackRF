+void HackRFGainDialog::setConnected (
+  bool connected)
+{
+  connected_ = connected;
+
+  lna_slider_->setEnabled (connected);
+  vga_slider_->setEnabled (connected);
+  tx_vga_slider_->setEnabled (connected);
+
+  if (!connected)
+    {
+      amp_check_->setEnabled (false);
+    }
+}
