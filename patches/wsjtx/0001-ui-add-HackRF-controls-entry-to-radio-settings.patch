+++ b/Configuration.ui
@@ -1533,6 +1533,16 @@ other hardware interface for PTT.</string>
             </item>
            </layout>
           </item>
+          <item row="2" column="0" colspan="4">
+           <widget class="QPushButton" name="hackrf_controls_button">
+            <property name="toolTip">
+             <string>Open HackRF receiver and transmitter controls.</string>
+            </property>
+            <property name="text">
+             <string>HackRF Controls...</string>
+            </property>
+           </widget>
+          </item>
           <item row="0" column="0">
            <widget class="QRadioButton" name="rbHamlib64">
             <property name="text">
