   Q_SLOT void on_revert_update_button_clicked (bool);
   Q_SLOT void on_gbSpecialOpActivity_clicked (bool);
   Q_SLOT void on_rbFox_clicked (bool);
@@ -3855,6 +3856,12 @@ void Configuration::impl::on_decoded_text_font_push_button_clicked ()
                                                   );
 }
 
+void Configuration::impl::on_hackrf_controls_button_clicked (bool /*clicked*/)
+{
+  MessageBox::information_message (
+    this, tr ("HackRF Controls"), tr ("HackRF control interface test."));
+}
+
 void Configuration::impl::on_hamlib_download_button_clicked (bool /*clicked*/)
 {
 #ifdef WIN32
diff --git a/Configuration.ui b/Configuration.ui
index d7b9c0a1e..498c4d04d 100644
