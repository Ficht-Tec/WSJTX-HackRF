+
+bool CabrilloLog::export_edi (
+  QTextStream& stream,
+  EDIExportOptions const& options,
+  QString * error) const
+{
+  auto fail =
+    [error] (QString const& message)
+    {
+      if (error)
+        {
+          *error = message;
+        }
+
+      return false;
+    };
+
+  if (options.contest_name.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI contest name is empty"));
+
+  if (options.callsign.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI callsign is empty"));
+
+  if (!edi_locator_valid (options.locator))
+    return fail (
+      tr ("EDI station locator must contain "
+          "4 or 6 Maidenhead characters"));
+
+  if (options.section.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI section is empty"));
+
+  auto const pband =
+    edi_band_name (options.band);
+
+  if (pband.isEmpty ())
+    return fail (
+      tr ("Band \"%1\" has no REG1TEST PBand mapping")
+        .arg (options.band));
+
+  //
+  // IARU R1 current minimum contest header information.
+  //
+  if (options.responsible_call.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI responsible operator callsign is empty"));
+
+  if (options.email.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI responsible operator e-mail is empty"));
+
+  if (options.tx_power.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI TX power is empty"));
+
+  if (options.antenna.trimmed ().isEmpty ())
+    return fail (
+      tr ("EDI antenna description is empty"));
+
+
+  QSqlQuery query;
+
+  SQL_error_check (
+    query,
+    static_cast<bool (QSqlQuery::*) (QString const&)>
+      (&QSqlQuery::exec),
+    "SELECT "
+    "frequency, "
+    "\"when\", "
+    "call, "
+    "exchange_sent, "
+    "exchange_rcvd "
+    "FROM cabrillo_log_v2 "
+    "ORDER BY \"when\"");
+
+
+  struct EDIRecord
+  {
+    QString line;
+    QDate date;
+    QString call;
+    QString locator;
+    QString exchange;
+    int points;
+    bool duplicate;
+  };
+
+  QVector<EDIRecord> records;
+
+  QSet<QString> worked_calls;
+  QSet<QString> worked_large_wwl;
+  QSet<QString> worked_exchange;
+
+  int total_points {0};
+  int valid_qsos {0};
+
+  QString odx_call;
+  QString odx_locator;
+  int odx_distance {0};
+
+  auto const own_locator =
+    options.locator.trimmed ().toUpper ();
+
+  int const band_multiplier =
+    edi_band_multiplier (options.band);
+
+
+  while (query.next ())
+    {
+      auto const frequency =
+        query.value (0)
+          .value<Radio::Frequency> ();
+
+      auto const band =
+        m_->configuration_->bands ()->find (
+          frequency);
+
+      //
+      // REG1TEST se entrega por banda.
+      //
+      if (band != options.band)
+        {
+          continue;
+        }
+
+      auto const when =
+        QDateTime::fromMSecsSinceEpoch (
+          query.value (1).toULongLong ()
+          * 1000ull,
+          Qt::UTC);
+
+      auto const call =
+        query.value (2)
+          .toString ()
+          .trimmed ()
+          .toUpper ();
+
+      auto const sent =
+        parse_edi_exchange (
+          query.value (3).toString ());
+
+      auto const received =
+        parse_edi_exchange (
+          query.value (4).toString ());
+
+      if (call.size () < 3
+          || call.size () > 14)
+        {
+          return fail (
+            tr ("Callsign \"%1\" cannot be represented "
+                "in a REG1TEST QSO record")
+              .arg (call));
+        }
+
+      bool const duplicate =
+        worked_calls.contains (call);
+
+      worked_calls.insert (call);
+
+      int distance {0};
+      int points {0};
+
+      if (!received.locator.isEmpty ())
+        {
+          distance =
+            edi_distance_points (
+              own_locator,
+              received.locator);
+        }
+
+      if (!duplicate)
+        {
+          points = distance;
+
+          //
+          // Regla MGM 50/70 MHz:
+          // dentro del mismo Large Locator, 50 puntos.
+          //
+          if ((options.band == "6m"
+               || options.band == "4m")
+              && !received.locator.isEmpty ()
+              && own_locator.left (4)
+                   == received.locator.left (4))
+            {
+              points = 50;
+            }
+
+          points *= band_multiplier;
+          ++valid_qsos;
+        }
+      else
+        {
+          points = 0;
+        }
+
+      QString new_exchange;
+
+      if (!received.exchange.isEmpty ()
+          && !worked_exchange.contains (
+            received.exchange))
+        {
+          new_exchange =
+            QStringLiteral ("N");
+
+          worked_exchange.insert (
+            received.exchange);
+        }
+
+      QString new_wwl;
+
+      QString const large_wwl =
+        received.locator.left (4);
+
+      if (large_wwl.size () == 4
+          && !worked_large_wwl.contains (
+            large_wwl))
+        {
+          new_wwl =
+            QStringLiteral ("N");
+
+          worked_large_wwl.insert (
+            large_wwl);
+        }
+
+
+      QStringList fields;
+
+      fields
+        << when.date ().toString ("yyMMdd")
+        << when.time ().toString ("hhmm")
+        << call
+        << QStringLiteral ("7")
+        << sent.rst
+        << sent.serial
+        << received.rst
+        << received.serial
+        << received.exchange
+        << received.locator
+        << QString::number (points)
+        << new_exchange
+        << new_wwl
+        << QString {}
+        << (duplicate
+              ? QStringLiteral ("D")
+              : QString {});
+
+      auto const line =
+        fields.join (';');
+
+      if (line.size () > 75)
+        {
+          return fail (
+            tr ("REG1TEST QSO record exceeds "
+                "75 characters:\n%1")
+              .arg (line));
+        }
+
+      records.push_back (
+        {
+          line,
+          when.date (),
+          call,
+          received.locator,
+          received.exchange,
+          points,
+          duplicate
+        });
+
+      total_points += points;
+
+      if (!duplicate
+          && distance > odx_distance)
+        {
+          odx_distance = distance;
+          odx_call = call;
+          odx_locator =
+            received.locator;
+        }
+    }
+
+
+  if (records.isEmpty ())
+    {
+      return fail (
+        tr ("There are no Cabrillo-log QSOs "
+            "for band %1")
+          .arg (options.band));
+    }
+
+
+  auto const first_date =
+    records.front ().date;
+
+  auto const last_date =
+    records.back ().date;
+
+  int claimed_score =
+    total_points;
+
+  if (options.score_mode
+      == EDIScoreMode::IaruRegion1LocatorMultiplier)
+    {
+      claimed_score =
+        total_points
+        * worked_large_wwl.size ();
+    }
+
+
+  auto line =
+    [&stream] (QString const& value)
+    {
+      stream << value << "\r\n";
+    };
+
+
+  line ("[REG1TEST;1]");
+
+  line (
+    "TName="
+    + edi_clean_header (
+      options.contest_name));
+
+  line (
+    QStringLiteral ("TDate=%1;%2")
+      .arg (
+        first_date.toString ("yyyyMMdd"),
+        last_date.toString ("yyyyMMdd")));
+
+  line (
+    "PCall="
+    + edi_clean_header (
+      options.callsign.toUpper ()));
+
+  line (
+    "PWWLo="
+    + own_locator.left (6));
+
+  line (
+    "PExch="
+    + edi_clean_header (
+      options.exchange));
+
+  line ("PAdr1=");
+  line ("PAdr2=");
+
+  line (
+    "PSect="
+    + edi_clean_header (
+      options.section));
+
+  line (
+    "PBand="
+    + pband);
+
+  line (
+    "PClub="
+    + edi_clean_header (
+      options.club));
+
+  line ("RName=");
+
+  line (
+    "RCall="
+    + edi_clean_header (
+      options.responsible_call.toUpper ()));
+
+  line ("RAdr1=");
+  line ("RAdr2=");
+  line ("RPoCo=");
+  line ("RCity=");
+  line ("RCoun=");
+  line ("RPhon=");
+
+  line (
+    "RHBBS="
+    + edi_clean_header (
+      options.email));
+
+  line (
+    "MOpe1="
+    + edi_clean_header (
+      options.operators));
+
+  line ("MOpe2=");
+  line ("STXEq=");
+
+  line (
+    "SPowe="
+    + edi_clean_header (
+      options.tx_power));
+
+  line ("SRXEq=");
+
+  line (
+    "SAnte="
+    + edi_clean_header (
+      options.antenna));
+
+  line ("SAntH=");
+
+  line (
+    QStringLiteral ("CQSOs=%1;1")
+      .arg (valid_qsos));
+
+  line (
+    QStringLiteral ("CQSOP=%1")
+      .arg (total_points));
+
+  line (
+    QStringLiteral ("CWWLs=%1;0;1")
+      .arg (worked_large_wwl.size ()));
+
+  line ("CWWLB=0");
+
+  line (
+    QStringLiteral ("CExcs=%1;0;1")
+      .arg (worked_exchange.size ()));
+
+  line ("CExcB=0");
+  line ("CDXCs=0;0;1");
+  line ("CDXCB=0");
+
+  //
+  // La fórmula de puntuación no pertenece al formato
+  // REG1TEST sino a las reglas del concurso.
+  //
+  line (
+    QStringLiteral ("CToSc=%1")
+      .arg (claimed_score));
+
+  if (!odx_call.isEmpty ())
+    {
+      line (
+        QStringLiteral ("CODXC=%1;%2;%3")
+          .arg (
+            odx_call,
+            odx_locator,
+            QString::number (
+              odx_distance)));
+    }
+  else
+    {
+      line ("CODXC=");
+    }
+
+  line ("[Remarks]");
+
+  if (!options.remarks.trimmed ().isEmpty ())
+    {
+      auto const remarks =
+        edi_clean_header (
+          options.remarks);
+
+      line (remarks.left (75));
+    }
+
+  line (
+    QStringLiteral ("[QSORecords;%1]")
+      .arg (records.size ()));
+
+
+  for (auto const& record : records)
+    {
+      line (record.line);
+    }
+
+  return true;
+}
