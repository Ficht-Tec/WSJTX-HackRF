+  struct EDIExchange
+  {
+    QString rst;
+    QString serial;
+    QString exchange;
+    QString locator;
+  };
+
+
+  bool edi_locator_valid (QString const& value)
+  {
+    static QRegularExpression const re {
+      QStringLiteral (
+        "^[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2})?$")
+    };
+
+    return re.match (value).hasMatch ();
+  }
+
+
+  EDIExchange parse_edi_exchange (QString const& text)
+  {
+    EDIExchange result;
+
+    auto tokens =
+      text.trimmed ().split (
+        ' ',
+        SkipEmptyParts);
+
+    if (tokens.isEmpty ())
+      {
+        return result;
+      }
+
+    //
+    // Formato clásico VHF:
+    //   59003 JO20DB
+    //   579123 IN55CC
+    //
+    // MGM:
+    //   -10 IO91
+    //   IO91
+    //
+    auto first = tokens.front ().trimmed ();
+
+    static QRegularExpression const combined {
+      QStringLiteral ("^[0-9]{5,7}$")
+    };
+
+    static QRegularExpression const report {
+      QStringLiteral ("^[+-]?[0-9]{2,3}$")
+    };
+
+    if (combined.match (first).hasMatch ())
+      {
+        if (first.size () == 5)
+          {
+            result.rst = first.left (2);
+            result.serial = first.mid (2);
+          }
+        else
+          {
+            result.rst = first.left (3);
+            result.serial = first.mid (3);
+          }
+
+        tokens.removeFirst ();
+      }
+    else if (report.match (first).hasMatch ())
+      {
+        result.rst = first;
+        tokens.removeFirst ();
+      }
+
+    QStringList remainder;
+
+    for (auto const& token : tokens)
+      {
+        auto value = token.trimmed ();
+
+        if (result.locator.isEmpty ()
+            && edi_locator_valid (value))
+          {
+            result.locator =
+              value.toUpper ();
+            continue;
+          }
+
+        if (result.serial.isEmpty ())
+          {
+            bool numeric {false};
+            value.toUInt (&numeric);
+
+            if (numeric
+                && (value.size () == 3
+                    || value.size () == 4))
+              {
+                result.serial = value;
+                continue;
+              }
+          }
+
+        remainder << value;
+      }
+
+    //
+    // EDI permite Exchange de hasta 6 caracteres.
+    // No concatenamos ni truncamos datos para "hacerlos caber".
+    //
+    if (remainder.size () == 1
+        && remainder.front ().size () <= 6)
+      {
+        result.exchange =
+          remainder.front ().toUpper ();
+      }
+
+    return result;
+  }
+
+
+  struct EDILocation
+  {
+    double latitude;
+    double longitude;
+  };
+
+
+  bool edi_locator_center (
+    QString locator,
+    EDILocation * result)
+  {
+    locator =
+      locator.trimmed ().toUpper ();
+
+    if (!result
+        || !edi_locator_valid (locator))
+      {
+        return false;
+      }
+
+    double lon =
+      (locator.at (0).unicode () - 'A') * 20.0
+      - 180.0;
+
+    double lat =
+      (locator.at (1).unicode () - 'A') * 10.0
+      - 90.0;
+
+    lon +=
+      locator.at (2).digitValue () * 2.0;
+
+    lat +=
+      locator.at (3).digitValue ();
+
+    if (locator.size () == 4)
+      {
+        //
+        // Centro del square de 2 x 1 grados.
+        //
+        lon += 1.0;
+        lat += 0.5;
+      }
+    else
+      {
+        lon +=
+          (locator.at (4).unicode () - 'A')
+          * (5.0 / 60.0);
+
+        lat +=
+          (locator.at (5).unicode () - 'A')
+          * (2.5 / 60.0);
+
+        //
+        // Centro del subsquare.
+        //
+        lon += 2.5 / 60.0;
+        lat += 1.25 / 60.0;
+      }
+
+    result->latitude = lat;
+    result->longitude = lon;
+    return true;
+  }
+
+
+  int edi_distance_points (
+    QString const& own_locator,
+    QString const& remote_locator)
+  {
+    EDILocation a {};
+    EDILocation b {};
+
+    if (!edi_locator_center (own_locator, &a)
+        || !edi_locator_center (remote_locator, &b))
+      {
+        return 0;
+      }
+
+    constexpr double pi =
+      3.14159265358979323846;
+
+    auto radians =
+      [pi] (double degrees)
+      {
+        return degrees * pi / 180.0;
+      };
+
+    double const lat1 = radians (a.latitude);
+    double const lat2 = radians (b.latitude);
+
+    double const delta_lon =
+      radians (b.longitude - a.longitude);
+
+    double cosine =
+      std::sin (lat1) * std::sin (lat2)
+      + std::cos (lat1) * std::cos (lat2)
+      * std::cos (delta_lon);
+
+    if (cosine > 1.0)
+      cosine = 1.0;
+    else if (cosine < -1.0)
+      cosine = -1.0;
+
+    double const central_angle_deg =
+      std::acos (cosine) * 180.0 / pi;
+
+    //
+    // IARU R1: 111.2 km/grado,
+    // truncar distancia y sumar 1 km.
+    //
+    return
+      static_cast<int> (
+        std::floor (
+          central_angle_deg * 111.2))
+      + 1;
+  }
+
+
+  QString edi_band_name (
+    QString const& wsjt_band)
+  {
+    if (wsjt_band == "6m")
+      return QStringLiteral ("50 MHz");
+
+    if (wsjt_band == "4m")
+      return QStringLiteral ("70 MHz");
+
+    if (wsjt_band == "2m")
+      return QStringLiteral ("145 MHz");
+
+    if (wsjt_band == "70cm")
+      return QStringLiteral ("435 MHz");
+
+    if (wsjt_band == "23cm")
+      return QStringLiteral ("1,3 GHz");
+
+    if (wsjt_band == "13cm")
+      return QStringLiteral ("2,3 GHz");
+
+    if (wsjt_band == "9cm")
+      return QStringLiteral ("3,4 GHz");
+
+    if (wsjt_band == "6cm")
+      return QStringLiteral ("5,7 GHz");
+
+    if (wsjt_band == "3cm")
+      return QStringLiteral ("10 GHz");
+
+    if (wsjt_band == "1.25cm")
+      return QStringLiteral ("24 GHz");
+
+    if (wsjt_band == "6mm")
+      return QStringLiteral ("47 GHz");
+
+    if (wsjt_band == "4mm")
+      return QStringLiteral ("76 GHz");
+
+    if (wsjt_band == "2.5mm")
+      return QStringLiteral ("120 GHz");
+
+    if (wsjt_band == "2mm")
+      return QStringLiteral ("144 GHz");
+
+    if (wsjt_band == "1mm")
+      return QStringLiteral ("248 GHz");
+
+    return {};
+  }
+
+
+  int edi_band_multiplier (
+    QString const& wsjt_band)
+  {
+    if (wsjt_band == "6mm")
+      return 2;
+
+    if (wsjt_band == "4mm")
+      return 3;
+
+    if (wsjt_band == "2.5mm")
+      return 4;
+
+    if (wsjt_band == "2mm")
+      return 8;
+
+    if (wsjt_band == "1mm")
+      return 10;
+
+    return 1;
+  }
+
+
+  QString edi_clean_header (
+    QString value)
+  {
+    value.replace ('\r', ' ');
+    value.replace ('\n', ' ');
+    return value.trimmed ();
+  }
+}
