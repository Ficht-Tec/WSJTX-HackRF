     }
 }
 
+void MainWindow::on_actionExport_ADIF_log_triggered()
+{
+  QString const source_name =
+    m_config.writeable_data_dir ()
+      .absoluteFilePath ("wsjtx_log.adi");
+
+  QFile source {source_name};
+
+  if (!source.exists ())
+    {
+      MessageBox::warning_message (
+        this,
+        tr ("Export ADIF Log"),
+        tr ("The ADIF log does not exist:\n%1")
+          .arg (source_name));
+
+      return;
+    }
+
+  QString file_name =
+    QFileDialog::getSaveFileName (
+      this,
+      tr ("Export ADIF Log"),
+      QDir::home ().absoluteFilePath ("wsjtx_log.adif"),
+      tr ("ADIF Log (*.adif);;ADI Log (*.adi);;All files (*)"));
+
+  if (file_name.isEmpty ())
+    {
+      return;
+    }
+
+  //
+  // La extensión .adi y .adif contienen el mismo formato ADIF.
+  // Si no se especifica ninguna, usamos .adif para la exportación.
+  //
+  if (!file_name.endsWith (
+        QStringLiteral (".adif"),
+        Qt::CaseInsensitive)
+      && !file_name.endsWith (
+        QStringLiteral (".adi"),
+        Qt::CaseInsensitive))
+    {
+      file_name += QStringLiteral (".adif");
+    }
+
+  if (!source.open (QIODevice::ReadOnly))
+    {
+      MessageBox::warning_message (
+        this,
+        tr ("Export ADIF Log"),
+        tr ("Cannot open \"%1\" for reading")
+          .arg (source.fileName ()),
+        tr ("Error: %1")
+          .arg (source.errorString ()));
+
+      return;
+    }
+
+  QByteArray const data = source.readAll ();
+  source.close ();
+
+  QFile destination {file_name};
+
+  if (!destination.open (
+        QIODevice::WriteOnly
+        | QIODevice::Truncate))
+    {
+      MessageBox::warning_message (
+        this,
+        tr ("Export ADIF Log"),
+        tr ("Cannot open \"%1\" for writing")
+          .arg (destination.fileName ()),
+        tr ("Error: %1")
+          .arg (destination.errorString ()));
+
+      return;
+    }
+
+  qint64 const written =
+    destination.write (data);
+
+  destination.close ();
+
+  if (written != data.size ())
+    {
+      MessageBox::warning_message (
+        this,
+        tr ("Export ADIF Log"),
+        tr ("The ADIF log could not be completely written to:\n%1")
+          .arg (file_name));
+
+      return;
+    }
+
+  showStatusMessage (
+    tr ("ADIF log exported to %1")
+      .arg (file_name));
+}
+
+
 void MainWindow::on_actionExport_Cabrillo_log_triggered()
 {
   if (QDialog::Accepted == ExportCabrillo {m_settings, &m_config, m_logBook.contest_log ()}.exec())
