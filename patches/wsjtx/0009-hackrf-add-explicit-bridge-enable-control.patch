   //
+  // Bridge startup
+  //
+  QString const bridge_config_dir =
+    QStandardPaths::writableLocation (
+      QStandardPaths::ConfigLocation)
+    + QStringLiteral ("/wsjtx-hackrf");
+
+  QString const bridge_enable_file =
+    bridge_config_dir
+    + QStringLiteral ("/bridge-enabled");
+
+  auto * bridge_enable_check =
+    new QCheckBox {
+      tr ("Enable HackRF bridge on next startup"),
+      this};
+
+  bridge_enable_check->setChecked (
+    QFileInfo::exists (bridge_enable_file));
+
+  connect (
+    bridge_enable_check,
+    &QCheckBox::toggled,
+    this,
+    [this,
+     bridge_enable_check,
+     bridge_config_dir,
+     bridge_enable_file] (bool enabled)
+    {
+      bool success {false};
+
+      if (enabled)
+        {
+          QDir dir;
+
+          if (dir.mkpath (bridge_config_dir))
+            {
+              QFile file {bridge_enable_file};
+
+              success =
+                file.open (
+                  QIODevice::WriteOnly
+                  | QIODevice::Truncate);
+
+              if (success)
+                {
+                  file.write ("1\n");
+                  file.close ();
+                }
+            }
+        }
+      else
+        {
+          success =
+            !QFileInfo::exists (bridge_enable_file)
+            || QFile::remove (bridge_enable_file);
+        }
+
+      if (!success)
+        {
+          QSignalBlocker blocker {
+            bridge_enable_check};
+
+          bridge_enable_check->setChecked (
+            !enabled);
+
+          QMessageBox::warning (
+            this,
+            tr ("HackRF bridge"),
+            tr ("Unable to change the HackRF bridge "
+                "startup setting."));
+
+          return;
+        }
+
+      QMessageBox::information (
+        this,
+        tr ("HackRF bridge"),
+        enabled
+          ? tr ("The HackRF bridge will be enabled "
+                "the next time WSJT-X is started.\n\n"
+                "To use it, configure:\n"
+                "Settings -> Radio\n"
+                "Rig: Hamlib NET rigctl\n"
+                "Network Server: 127.0.0.1:4532\n\n"
+                "Restart WSJT-X after applying these settings.")
+          : tr ("The HackRF bridge will remain disabled "
+                "the next time WSJT-X is started."));
+    });
+
+
